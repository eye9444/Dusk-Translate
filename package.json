{
  "name": "dusk-translate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-editor.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-editor.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config=config/playwright.config.js",
    "test:auth": "playwright test --config=config/playwright.auth.config.js",
    "test:modules": "playwright test --config=config/playwright.modules.config.js"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@supabase/supabase-js": "^2.57.0",
    "jszip": "3.10.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
